generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ticketsAsCustomer Ticket[]       @relation("CustomerTickets")
  ticketsAsAgent    Ticket[]       @relation("AgentTickets")
  messages          Message[]
  refreshTokens     RefreshToken[]
  travelProfile     TravelProfile?
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Populated only when status transitions to CLOSED. closedBy is a plain
  // string (not a relation) so a close record survives the closer's account
  // deletion without needing an onDelete behavior of its own.
  closeReason String?
  closedAt    DateTime?
  closedBy    String?

  // Populated only when status transitions back to OPEN from CLOSED. Same
  // single-snapshot pattern as the close fields above — a repeat
  // close/reopen cycle overwrites the previous reopen record rather than
  // preserving history. reopenedBy is a plain string for the same reason
  // as closedBy: survives the reopener's account deletion.
  reopenReason String?
  reopenedAt   DateTime?
  reopenedBy   String?

  customerId  String?
  customer    User?   @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: SetNull)

  agentId     String?
  agent       User?   @relation("AgentTickets", fields: [agentId], references: [id], onDelete: SetNull)

  messages    Message[]
}

model Message {
  id            String   @id @default(cuid())
  content       String
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelAgency {
  id String @id
  name String
  code String @unique
  slaCalendar Json?
  responseTargetHours Int @default(24)
  responsePolicyVersion Int @default(1)
  contracts TravelContract[]
  bookings TravelBooking[]
  profiles TravelProfile[]
  tickets TravelTicket[]
}

model TravelContract {
  id String @id @default(cuid())
  agencyId String
  agency TravelAgency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  name String
  active Boolean @default(true)
  slaCalendar Json?
  responseTargetHours Int
  responsePolicyVersion Int @default(1)
  tickets TravelTicket[]
  @@unique([id, agencyId])
  @@index([agencyId, active, name, id])
}

model TravelSupplier {
  slaCalendar Json?
  responseTargetHours Int @default(4)
  responsePolicyVersion Int @default(1)
  id String @id
  name String
  email String
  bookings TravelBooking[]
  profiles TravelProfile[]
  conversations TravelConversation[]
}

model TravelProfile {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind String
  agencyId String?
  agency TravelAgency? @relation(fields: [agencyId], references: [id])
  supplierId String?
  supplier TravelSupplier? @relation(fields: [supplierId], references: [id])
  region String?
  available Boolean @default(true)
  specialties String[] @default([])
  shiftCalendar Json?
  maxActiveCases Int?
  status String @default("ACTIVE")
  sessionVersion Int @default(0)
  invitations TravelInvitation[]
}

model TravelBooking {
  id String @id @default(cuid())
  reference String
  agencyId String
  agency TravelAgency @relation(fields: [agencyId], references: [id])
  customerId String
  supplierId String
  supplier TravelSupplier @relation(fields: [supplierId], references: [id])
  destination String
  region String
  service String
  checkInAt DateTime
  departureAt DateTime?
  cancellationCutoffAt DateTime?
  timezone String
  providerImport TravelBookingImport?
  tickets TravelTicket[]
  @@unique([agencyId, reference])
  @@index([customerId])
}

model TravelBookingImport {
  bookingId String @id
  booking TravelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providerSource String
  providerBookingId String
  providerUpdatedAt DateTime
  providerStatus String
  providerPayloadHash String
  @@unique([providerSource, providerBookingId])
}

model TravelTicket {
  id String @id @default(cuid())
  reference String @unique
  title String
  description String
  agencyId String
  agency TravelAgency @relation(fields: [agencyId], references: [id])
  contractId String?
  contract TravelContract? @relation(fields: [contractId, agencyId], references: [id, agencyId], onDelete: Restrict, onUpdate: Restrict)
  customerId String
  bookingId String?
  booking TravelBooking? @relation(fields: [bookingId], references: [id])
  category String
  status String @default("OPEN")
  priority String @default("MEDIUM")
  region String
  agentId String?
  autoHandoff Boolean @default(false)
  deadline DateTime
  responseDeadline DateTime?
  responseStartedAt DateTime?
  slaSnapshot Json?
  slaPausedAt DateTime?
  slaRemainingMs Float?
  escalationOwnerId String?
  escalationManual Boolean @default(false)
  escalationOverrideUntil DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages TravelMessage[]
  conversations TravelConversation[]
  events TravelEvent[]
  inboundMail TravelInboundMail[]
  @@index([agencyId, customerId])
  @@index([status, deadline])
  @@index([autoHandoff, status, id])
  @@index([bookingId, createdAt, id])
}

model TravelConversation {
  id String @id @default(cuid())
  ticketId String
  ticket TravelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  supplierId String
  supplier TravelSupplier @relation(fields: [supplierId], references: [id])
  subject String
  slaSnapshot Json?
  status String @default("AWAITING_REPLY")
  dueAt DateTime
  createdAt DateTime @default(now())
  messages TravelMessage[]
  @@index([supplierId])
  @@index([supplierId, createdAt, id])
  @@index([ticketId, createdAt, id])
}

model TravelMessage {
  id String @id @default(cuid())
  ticketId String
  ticket TravelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation TravelConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId String
  visibility String
  content String
  createdAt DateTime @default(now())
  mailJob TravelMailJob?
  attachments TravelAttachment[]
  @@index([ticketId, createdAt])
  @@index([ticketId, visibility, createdAt, id, senderId])
  @@index([conversationId, createdAt, id])
}

model TravelAttachment {
  id String @id @default(cuid())
  messageId String
  message TravelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename String
  mimeType String
  size Int
  sha256 String
  bytes Bytes
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([messageId, createdAt])
  @@index([expiresAt])
}

model TravelInboundMail {
  id String @id
  ticketId String
  ticket TravelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId])
}

model TravelMailJob {
  id String @id @default(cuid())
  messageId String @unique
  message TravelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient String
  transport String @default("SYNTHETIC")
  providerId String?
  replyEnabled Boolean @default(false)
  status String @default("QUEUED")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  createdAt DateTime @default(now())
  history TravelMailAttempt[]
  receipts TravelMailReceipt[]
  @@index([transport, status, nextAttemptAt])
}

model TravelMailReceipt {
  id String @id
  jobId String
  job TravelMailJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId String
  kind String
  occurredAt DateTime
  @@index([jobId, occurredAt])
}

model TravelMailAttempt {
  id String @id @default(cuid())
  jobId String
  job TravelMailJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  outcome String
  actorId String?
  createdAt DateTime @default(now())
  @@index([jobId, createdAt])
}

model TravelEvent {
  id String @id @default(cuid())
  ticketId String
  ticket TravelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind String
  text String
  actorId String
  uniqueKey String? @unique
  createdAt DateTime @default(now())
  acknowledgedAt DateTime?
  @@index([ticketId, createdAt])
}

model TravelClock {
  id String @id
  offsetMinutes Int @default(0)
}

// Track the development counter table in migrations as well as using it through pg.
// This prevents schema-drift prompts when developers add future Prisma migrations.
model OpsCounter {
  key String @id
  value String
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
}

model TravelInvitation {
  id String @id @default(cuid())
  memberId String
  member TravelProfile @relation(fields: [memberId], references: [userId], onDelete: Restrict)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([memberId])
}

model MembershipAudit {
  id String @id @default(cuid())
  actorId String
  entityId String
  action String
  reason String
  createdAt DateTime @default(now())
  @@index([createdAt, id])
}

model TravelBookingRequest {
  id String @id @default(cuid())
  submitterId String
  agencyId String
  bookingId String?
  kind String
  payload Json
  reason String
  status String @default("PENDING")
  reviewerId String?
  decisionReason String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([agencyId, createdAt, id])
  @@index([status, createdAt, id])
}

model TravelEscalationRotation {
  region String @id
  enabled Boolean @default(false)
  managerIds String[]
  slotHours Int
  anchorAt DateTime
  version Int @default(1)
}
